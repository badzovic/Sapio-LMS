@using SIA.Sapio_LMS.Areas.Instructor.Models
@using SIA.Sapio_LMS.Models.Shared
@model MySubjectDetailsVM

@{
    ViewData["Title"] = "Upravljanje predmetom";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <partial name="~/Views/Shared/PagePartials/_PageHeader.cshtml"
             model='new PageHeaderVM
             {
                 Title = "Upravljanje predmetom",
                 Subtitle = Model.Naziv
             }' />

    <div class="card-custom">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="mb-1">@Model.Naziv</h3>

                @if (!string.IsNullOrWhiteSpace(Model.NazivEng))
                {
                    <small class="text-muted">@Model.NazivEng</small>
                }

                <div class="mt-2">
                    <small class="text-muted">
                        Instruktor od: @Model.InstruktorOd.ToString("dd.MM.yyyy")
                    </small>
                </div>
            </div>

            <a asp-area="Instructor"
               asp-controller="MySubjects"
               asp-action="Index"
               class="btn-sapio btn-sapio-secondary">
                Nazad na moje predmete
            </a>
        </div>
    </div>

    <div class="card-custom">
        <h5 class="mb-3">Opcije predmeta</h5>

        <div class="action-buttons">

            <a asp-area="Instructor"
               asp-controller="SubjectMaterials"
               asp-action="Index"
               asp-route-predmetId="@Model.PredmetId"
               class="btn-sapio btn-sapio-primary">
                <i class="fas fa-file-upload"></i>
                Materijali
            </a>

            <a asp-area="Instructor"
               asp-controller="SubjectQuestions"
               asp-action="Index"
               asp-route-predmetId="@Model.PredmetId"
               class="btn-sapio btn-sapio-success">
                <i class="fas fa-question-circle"></i>
                Baza pitanja
            </a>

            <a asp-area="Instructor"
               asp-controller="SubjectTests"
               asp-action="Index"
               asp-route-predmetId="@Model.PredmetId"
               class="btn-sapio btn-sapio-warning">
                <i class="fas fa-clipboard-list"></i>
                Testovi
            </a>

            <a asp-area="Instructor"
               asp-controller="TestResults"
               asp-action="Index"
               asp-route-predmetId="@Model.PredmetId"
               class="btn-sapio btn-sapio-danger">
                <i class="fas fa-chart-bar"></i>
                Rezultati testova
            </a>

        </div>

        <div class="mt-3">
            <small class="text-muted">
                Upravljajte materijalima, pitanjima i testovima za ovaj predmet.
            </small>
        </div>
    </div>

</div>