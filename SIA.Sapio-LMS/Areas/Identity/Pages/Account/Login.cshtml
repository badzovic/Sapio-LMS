@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card">

    <div class="auth-logo">
        <img src="~/lms/img/logo-ct-dark.png" style="max-width:34px;" />
    </div>

    <h3 class="auth-title">SIA Sapio LMS</h3>
    <div class="auth-subtitle">Prijavite se na svoj nalog</div>

    @if (TempData["AuthMessage"] != null)
    {
        <div class="alert alert-info mb-3">
            @TempData["AuthMessage"]
        </div>
    }

    <form method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="auth-label">Email ili ime i prezime</label>
            <input asp-for="Input.LoginIdentifier" class="form-control auth-input" />
        </div>

        @if (Model.Input != null && Model.Input.RequireFatherName)
        {
            <div class="mb-3">
                <label class="auth-label">Ime oca</label>
                <input asp-for="Input.FatherName" class="form-control auth-input" />
            </div>
        }

        <div class="mb-3">
            <label class="auth-label">Password</label>
            <input asp-for="Input.Password" class="form-control auth-input" type="password" />
        </div>

        <div class="form-check mb-4">
            <input class="form-check-input" asp-for="Input.RememberMe" />
            <label class="form-check-label text-sm text-muted" asp-for="Input.RememberMe">
                Zapamti me
            </label>
        </div>

        <button type="submit" class="auth-btn">
            <i class="fas fa-sign-in-alt"></i> Prijava
        </button>

    </form>

    <div class="auth-footer">
        © @DateTime.Now.Year SIA Sapio LMS
    </div>

</div>