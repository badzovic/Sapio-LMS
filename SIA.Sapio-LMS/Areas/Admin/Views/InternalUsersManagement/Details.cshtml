<div class="container-fluid">
    <div class="card-custom">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Detalji korisnika</h3>

            <a asp-area="Admin"
               asp-controller="InternalUsers"
               asp-action="Index"
               class="btn-sapio btn-sapio-secondary">
                Nazad na listu
            </a>
        </div>

        @*<div class="info-row"><span class="info-label">User ID:</span> @Model.UserId</div>*@
        <div class="info-row"><span class="info-label">Ime:</span> @Model.Ime</div>
        <div class="info-row"><span class="info-label">Prezime:</span> @Model.Prezime</div>
        <div class="info-row"><span class="info-label">Ime oca:</span> @Model.ImeOca</div>
        <div class="info-row"><span class="info-label">Email:</span> @Model.Email</div>
       @* <div class="info-row"><span class="info-label">HRM ID:</span> @Model.HrmId</div> *@
        <div class="info-row"><span class="info-label">Kompanija:</span> @Model.Kompanija</div>
        @* <div class="info-row"><span class="info-label">Access Key:</span> @Model.AccessKey</div> *@
    </div>

    <div class="card-custom">
        <h5 class="mb-3">Akcije</h5>

        <div class="action-buttons">
            <form asp-area="Admin"
                  asp-controller="InternalUsersManagement"
                  asp-action="ResetPassword"
                  method="post"
                  class="js-confirm-form d-inline"
                  data-confirm-title="Reset password?"
                  data-confirm-text="Resetovati password za korisnika @Model.Ime @Model.Prezime na Sarajevo2026! ?"
                  data-confirm-icon="warning"
                  data-confirm-button="Da, resetuj">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" value="@Model.UserId" />
                <button type="submit" class="btn-sapio btn-sapio-danger">
                    <i class="fas fa-key"></i> Reset password
                </button>
            </form>

            <form asp-area="Admin"
                  asp-controller="InternalUsersManagement"
                  asp-action="SyncSingleUser"
                  method="post"
                  class="js-confirm-form d-inline"
                  data-confirm-title="Sync korisnika?"
                  data-confirm-text="Da li želiš povući najnovije podatke iz HRM sistema za ovog korisnika?"
                  data-confirm-icon="question"
                  data-confirm-button="Da, sync">
                @Html.AntiForgeryToken()
                <input type="hidden" name="hrmId" value="@Model.HrmId" />
                <input type="hidden" name="userId" value="@Model.UserId" />

                <button type="submit" class="btn-sapio btn-sapio-warning">
                    <i class="fas fa-sync-alt"></i> Sync korisnika
                </button>
            </form>

            <form asp-area="Admin"
                  asp-controller="InternalUsersManagement"
                  asp-action="ToggleActive"
                  method="post"
                  class="js-confirm-form d-inline"
                  data-confirm-title="Promjena statusa?"
                  data-confirm-text="Da li želite promijeniti status korisnika?"
                  data-confirm-icon="warning"
                  data-confirm-button="Potvrdi">
                @Html.AntiForgeryToken()
                <input type="hidden" name="hrmId" value="@Model.HrmId" />
                <input type="hidden" name="userId" value="@Model.UserId" />

                <button type="submit"
                        class="btn-sapio @(isActive ? "btn-sapio-success" : "btn-sapio-secondary")">
                    <i class="fas @(isActive ? "fa-user-slash" : "fa-user-check")"></i>
                    @(isActive ? " Deaktiviraj" : " Aktiviraj")
                </button>
            </form>
        </div>
    </div>

    <div class="card-custom">
        <h5 class="mb-3">Role korisnika</h5>

        <div class="role-buttons">
            @foreach (var role in allRoles)
            {
                var hasRole = userRoles.Contains(role);

                <form asp-area="Admin"
                      asp-controller="InternalUsersManagement"
                      asp-action="ToggleRole"
                      method="post"
                      class="js-confirm-form d-inline"
                      data-confirm-title="Promjena role"
                      data-confirm-text="Da li želite @(hasRole ? "ukloniti" : "dodijeliti") rolu '@role' korisniku @Model.Ime @Model.Prezime?"
                      data-confirm-icon="question"
                      data-confirm-button="Da, potvrdi">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@Model.UserId" />
                    <input type="hidden" name="roleName" value="@role" />

                    <button type="submit"
                            class="btn-sapio @(hasRole ? "btn-sapio-success" : "btn-sapio-secondary")">
                        @role
                    </button>
                </form>
            }
        </div>

        <div class="mt-3">
            <small class="text-muted">
                Zelena boja znači da je rola aktivna. Siva znači da nije dodijeljena.
            </small>
        </div>
    </div>
</div>