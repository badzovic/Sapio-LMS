@model SIA.Sapio_LMS.Areas.Models.AssignTestStudentsVM

@{
    ViewData["Title"] = "Korisnici po matrici";

    var studentFilter = ViewBag.StudentFilter as string ?? "allMatrix";
}

<div class="container-fluid">

    <div class="page-toolbar d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Korisnici po matrici</h2>
            <p class="text-muted mb-0">@Model.PredmetNaziv</p>
        </div>

        <a asp-area="Admin"
           asp-controller="Predmeti"
           asp-action="Details"
           asp-route-id="@Model.PredmetId"
           class="btn-sapio btn-sapio-secondary">
            Nazad na predmet
        </a>
    </div>

    <div class="card-custom">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="mb-1">Korisnici koji trebaju polagati predmet</h5>
                <p class="text-muted mb-0">
                    Prikaz korisnika iz V3 matrice za odabrani predmet.
                </p>
            </div>

            <span class="badge bg-primary">
                @Model.Studenti.Count korisnika
            </span>
        </div>

        <div class="d-flex flex-wrap gap-2 mb-3">
            <a asp-area="Admin"
               asp-controller="PredmetMatrix"
               asp-action="Index"
               asp-route-predmetId="@Model.PredmetId"
               asp-route-studentFilter="allMatrix"
               class="btn-sapio @(studentFilter == "allMatrix" ? "btn-sapio-primary" : "btn-sapio-secondary") btn-sm">
                Svi iz matrice
            </a>

            <a asp-area="Admin"
               asp-controller="PredmetMatrix"
               asp-action="Index"
               asp-route-predmetId="@Model.PredmetId"
               asp-route-studentFilter="dueSoon"
               class="btn-sapio @(studentFilter == "dueSoon" ? "btn-sapio-primary" : "btn-sapio-secondary") btn-sm">
                Za polaganje / obnovu
            </a>
        </div>

        <div class="table-responsive">
            <table id="matrixUsersTable" class="table table-striped table-bordered align-middle w-100">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Email</th>
                        <th>Kompanija</th>
                        <th>Važi do</th>
                        <th>Status obuke</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var s in Model.Studenti)
                    {
                        <tr>
                            <td>
                                <strong>@s.ImePrezime</strong>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(s.Email) ? "-" : s.Email)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(s.Kompanija) ? "-" : s.Kompanija)
                            </td>

                            <td>
                                @if (s.DatumVaziDo.HasValue)
                                {
                                    @s.DatumVaziDo.Value.ToString("dd.MM.yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">Nema evidencije</span>
                                }
                            </td>

                            <td>
                                @if (s.StatusObuke == "Nema evidenciju")
                                {
                                    <span class="badge bg-warning text-dark">Nema evidenciju</span>
                                }
                                else if (s.StatusObuke == "Isteklo")
                                {
                                    <span class="badge bg-danger">Isteklo</span>
                                }
                                else if (s.StatusObuke == "Ističe u 60 dana")
                                {
                                    <span class="badge bg-info">Ističe u 60 dana</span>
                                }
                                else if (s.StatusObuke == "Važeće")
                                {
                                    <span class="badge bg-success">Važeće</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@s.StatusObuke</span>
                                }

                                @if (s.DanaDoIsteka.HasValue)
                                {
                                    <div class="text-muted small mt-1">
                                        @s.DanaDoIsteka dana
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#matrixUsersTable').DataTable({
                pageLength: 25,
                order: [[0, 'asc']],
                responsive: true,
                language: {
                    search: "Pretraga:",
                    lengthMenu: "Prikaži _MENU_ zapisa",
                    info: "Prikazano _START_ do _END_ od ukupno _TOTAL_ zapisa",
                    infoEmpty: "Nema zapisa",
                    zeroRecords: "Nema pronađenih korisnika",
                    paginate: {
                        previous: "Prethodna",
                        next: "Sljedeća"
                    }
                }
            });
        });
    </script>
}