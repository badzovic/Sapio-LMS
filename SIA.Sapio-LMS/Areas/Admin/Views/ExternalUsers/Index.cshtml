@using SIA.Sapio_LMS.Areas.Admin.Models
@using SIA.Sapio_LMS.Models.Shared
@model List<ExternalUsersVM>

@{
    ViewData["Title"] = "External Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentStatus = (ViewBag.CurrentStatus as string ?? "active").ToLower();
}

<div class="container-fluid">

    <partial name="~/Views/Shared/PagePartials/_PageHeader.cshtml"
             model='new PageHeaderVM
             {
                 Title = "External Users",
                 Subtitle = "Pregled eksternih korisnika povučenih iz V3 baze"
             }' />

    <div class="card-custom page-toolbar">
        <div class="page-toolbar-row">
            <a asp-area="Admin"
               asp-controller="ExternalUsers"
               asp-action="Index"
               asp-route-status="active"
               class="btn-sapio @(currentStatus == "active" ? "btn-sapio-primary" : "btn-sapio-secondary")">
                <i class="fas fa-user-check"></i> Aktivni
            </a>

            <a asp-area="Admin"
               asp-controller="ExternalUsers"
               asp-action="Index"
               asp-route-status="inactive"
               class="btn-sapio @(currentStatus == "inactive" ? "btn-sapio-warning" : "btn-sapio-secondary")">
                <i class="fas fa-user-slash"></i> Neaktivni
            </a>

            <a asp-area="Admin"
               asp-controller="ExternalUsers"
               asp-action="Index"
               asp-route-status="all"
               class="btn-sapio @(currentStatus == "all" ? "btn-sapio-success" : "btn-sapio-secondary")">
                <i class="fas fa-users"></i> Svi
            </a>

            <form asp-area="Admin"
                  asp-controller="ExternalUsers"
                  asp-action="ImportAll"
                  method="post"
                  class="js-confirm-form m-0"
                  data-confirm-title="Import eksternih korisnika?"
                  data-confirm-text="Da li želite importovati eksterne korisnike u LMS bazu i Identity?"
                  data-confirm-icon="warning"
                  data-confirm-button="Da, importuj">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn-sapio btn-sapio-primary">
                    <i class="fas fa-download"></i> Import eksternih korisnika
                </button>
            </form>

            <form asp-area="Admin"
                  asp-controller="ExternalUsers"
                  asp-action="SyncAllExternalUsers"
                  method="post"
                  class="js-confirm-form m-0"
                  data-confirm-title="Sync svih eksternih korisnika?"
                  data-confirm-text="Da li želite osvježiti postojeće eksterne korisnike iz V3 baze? Ova akcija će updateovati podatke i u LMS i u Identity tabelama."
                  data-confirm-icon="warning"
                  data-confirm-button="Da, syncuj">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn-sapio btn-sapio-success">
                    <i class="fas fa-sync-alt"></i> Sync svih eksternih korisnika
                </button>
            </form>

            @*
            <form asp-area="Admin"
                  asp-controller="ExternalUsers"
                  asp-action="SyncCompanyIds"
                  method="post"
                  class="js-confirm-form m-0"
                  data-confirm-title="Sync kompanija?"
                  data-confirm-text="Da li želite mapirati KOMPANIJA_ID za eksterne korisnike na osnovu V3 podataka?"
                  data-confirm-icon="warning"
                  data-confirm-button="Da, sync">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn-sapio btn-sapio-warning">
                    <i class="fas fa-building"></i> Sync Company IDs
                </button>
            </form>
            *@
        </div>
    </div>

    <div class="card-custom">
        <div class="table-responsive">
            <table id="externalUsersTable" class="table table-bordered table-striped w-100">
                <thead>
                    <tr>
                        <th>Ime</th>
                        <th>Prezime</th>
                        <th>Ime oca</th>
                        <th>Mjesto rođenja</th>
                        <th>Kompanija</th>
                        <th>Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Ime</td>
                                <td>@user.Prezime</td>
                                <td>@user.ImeOca</td>
                                <td>@user.MjestoRodjenja</td>
                                <td>@user.Kompanija</td>
                                <td>
                                    <a asp-area="Admin"
                                       asp-controller="ExternalUsersManagement"
                                       asp-action="Details"
                                       asp-route-id="@user.ID"
                                       class="btn-sapio btn-sapio-primary btn-sapio-sm">
                                        <i class="fas fa-eye"></i> Detalji
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#externalUsersTable').DataTable({
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                ordering: true,
                searching: true,
                responsive: false,
                scrollX: true,
                language: {
                    search: "Pretraga:",
                    lengthMenu: "Prikaži _MENU_ zapisa",
                    info: "Prikaz _START_ do _END_ od _TOTAL_ zapisa",
                    infoEmpty: "Nema zapisa",
                    zeroRecords: "Nema pronađenih korisnika",
                    paginate: {
                        first: "Prva",
                        last: "Zadnja",
                        next: "Sljedeća",
                        previous: "Prethodna"
                    }
                }
            });
        });
    </script>
}