@using SIA.Sapio_LMS.Areas.Admin.Controllers
@using SIA.Sapio_LMS.Models.Shared
@model List<InternalUserDto>

@{
    ViewData["Title"] = "Internal Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <partial name="~/Views/Shared/PagePartials/_PageHeader.cshtml"
             model='new PageHeaderVM
             {
                 Title = "Internal Users",
                 Subtitle = "Pregled korisnika povučenih preko internog API-ja"
             }' />

    <div class="card-custom page-toolbar">
        <div class="page-toolbar-row">
            <form asp-area="Admin"
                  asp-controller="InternalUsers"
                  asp-action="SyncInternalUsers"
                  method="post"
                  class="js-confirm-form m-0"
                  data-confirm-title="Sync korisnika?"
                  data-confirm-text="Pokrenuti sync internih korisnika i dopuniti IME_OCA?"
                  data-confirm-icon="warning"
                  data-confirm-button="Da, sync">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn-sapio btn-sapio-warning">
                    <i class="fas fa-sync-alt"></i> Sync korisnika
                </button>
            </form>           

            @*
            <form asp-area="Admin"
                  asp-controller="InternalUsers"
                  asp-action="AssignDefaultRoleToAllUsers"
                  method="post"
                  class="js-confirm-form m-0"
                  data-confirm-title="Dodjela role?"
                  data-confirm-text="Da li ste sigurni da želite svim korisnicima dodijeliti zadanu rolu?"
                  data-confirm-icon="warning"
                  data-confirm-button="Potvrdi">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn-sapio btn-sapio-primary">
                    <i class="fas fa-user-tag"></i> Dodijeli rolu svim korisnicima
                </button>
            </form>
            *@
        </div>
    </div>

    <div class="card-custom">
        <div class="table-responsive">
            <table id="internalUsersTable" class="table table-bordered table-striped w-100">
                <thead>
                    <tr>
                        <th>Ime</th>
                        <th>Prezime</th>
                        <th>Ime oca</th>
                        <th>Email</th>
                        <th>Kompanija</th>
                        <th>Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Ime</td>
                                <td>@user.Prezime</td>
                                <td>@user.ImeOca</td>
                                <td>@user.Email</td>
                                <td>@user.Kompanija</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(user.UserId))
                                    {
                                        <a asp-area="Admin"
                                           asp-controller="InternalUsersManagement"
                                           asp-action="Details"
                                           asp-route-userId="@user.UserId"
                                           class="btn-sapio btn-sapio-primary btn-sapio-sm">
                                            <i class="fas fa-eye"></i> Detalji
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Nema usera</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#internalUsersTable').DataTable({
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                ordering: true,
                searching: true,
                responsive: false,
                scrollX: true,
                language: {
                    search: "Pretraga:",
                    lengthMenu: "Prikaži _MENU_ zapisa",
                    info: "Prikaz _START_ do _END_ od _TOTAL_ zapisa",
                    infoEmpty: "Nema zapisa",
                    zeroRecords: "Nema pronađenih korisnika",
                    paginate: {
                        first: "Prva",
                        last: "Zadnja",
                        next: "Sljedeća",
                        previous: "Prethodna"
                    }
                }
            });
        });
    </script>
}