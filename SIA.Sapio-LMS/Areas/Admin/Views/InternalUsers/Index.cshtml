    </div>
    <div class="card-custom">
        <div class="table-responsive">
            <table id="internalUsersTable" class="table table-bordered table-striped w-100">
                <thead>
                    <tr>
                        @* <th>HRM ID</th> *@
                        <th>Ime</th>
                        <th>Prezime</th>
                        <th>Ime oca</th>
                        @* <th>JMB</th> *@
                        <th>Email</th>
                        <th>Kompanija</th>
                        @* <th>Access Key</th> *@
                        <th>Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                               @*  <td>@user.HrmId</td> *@
                                <td>@user.Ime</td>
                                <td>@user.Prezime</td>
                                <td>@user.ImeOca</td>
                                @* <td>@user.Jmb</td> *@
                                <td>@user.Email</td>
                                <td>@user.Kompanija </td>
                                @* <td>@user.AccessKey</td> *@
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(user.UserId))
                                    {
                                        <a asp-area="Admin"
                                           asp-controller="InternalUsersManagement"
                                           asp-action="Details"
                                           asp-route-userId="@user.UserId"
                                           class="btn-sapio btn-sapio-primary">
                                            <i class="fas fa-eye"></i> Detalji
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Nema usera</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {   

    <script>
        $(document).ready(function () {
            $('#internalUsersTable').DataTable({
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                ordering: true,
                searching: true,
                responsive: false,
                scrollX: true,
                language: {
                    search: "Pretraga:",
                    lengthMenu: "Prikaži _MENU_ zapisa",
                    info: "Prikaz _START_ do _END_ od _TOTAL_ zapisa",
                    infoEmpty: "Nema zapisa",
                    zeroRecords: "Nema pronađenih korisnika",
                    paginate: {
                        first: "Prva",
                        last: "Zadnja",
                        next: "Sljedeća",
                        previous: "Prethodna"
                    }
                }
            });
        });
    </script>
}