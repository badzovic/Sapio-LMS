@using SIA.Sapio_LMS.Areas.Admin.Models
@using SIA.Sapio_LMS.Models.Shared

@model List<AutoTestAssignmentRunVM>

@{
    ViewData["Title"] = "Logovi auto dodjele testova";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@functions {

    private string WrapText(string? text, int maxLineLength = 45)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "-";

        var words = text.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        var lines = new List<string>();
        var currentLine = "";

        foreach (var word in words)
        {
            if (string.IsNullOrWhiteSpace(currentLine))
            {
                currentLine = word;
                continue;
            }

            if ((currentLine.Length + 1 + word.Length) > maxLineLength)
            {
                lines.Add(currentLine.Trim());
                currentLine = word;
            }
            else
            {
                currentLine += " " + word;
            }
        }

        if (!string.IsNullOrWhiteSpace(currentLine))
            lines.Add(currentLine.Trim());

        return string.Join("<br />", lines);
    }

}

<div class="container-fluid">

    <partial name="~/Views/Shared/PagePartials/_PageHeader.cshtml"
             model='new PageHeaderVM
             {
                 Title = "Logovi auto dodjele testova",
                 Subtitle = "Pregled izvršavanja automatske dodjele testova"
             }' />

    <div class="card-custom">

        <div class="table-responsive">

            <table id="runsTable" class="table table-striped table-bordered align-middle w-100">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Datum pokretanja</th>
                        <th>Predmet</th>
                        <th>Status</th>
                        <th>Dodijeljeno</th>
                        <th>Sticanje</th>
                        <th>Obnova</th>
                        <th>Nema validnog testa</th>
                        <th>Već dodijeljeno</th>
                        <th>Greške</th>
                        <th>Akcije</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <strong>#@item.ID</strong>
                            </td>

                            <td>
                                <div>
                                    @item.DatumPokretanja.ToString("dd.MM.yyyy HH:mm")
                                </div>

                                @if (item.DatumZavrsetka.HasValue)
                                {
                                    <small class="text-muted">
                                        završeno:
                                        @item.DatumZavrsetka.Value.ToString("dd.MM.yyyy HH:mm")
                                    </small>
                                }
                            </td>

                            <td style="min-width:280px;">
                                @Html.Raw(WrapText(item.PredmetNaziv, 45))
                            </td>

                            <td>
                                @if (item.Status == "USPJESNO")
                                {
                                    <span class="badge bg-success">Uspješno</span>
                                }
                                else if (item.Status == "DJELIMICNO")
                                {
                                    <span class="badge bg-warning text-dark">Djelimično</span>
                                }
                                else if (item.Status == "GRESKA")
                                {
                                    <span class="badge bg-danger">Greška</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Status</span>
                                }
                            </td>

                            <td>
                                <strong>@item.UkupnoDodijeljeno</strong>
                            </td>

                            <td>
                                @item.UkupnoSticanje
                            </td>

                            <td>
                                @item.UkupnoObnova
                            </td>

                            <td>
                                @item.UkupnoNemaValidnogTesta
                            </td>

                            <td>
                                @item.UkupnoVecDodijeljeno
                            </td>

                            <td>
                                @item.UkupnoGresaka
                            </td>

                            <td>

                                <a asp-area="Admin"
                                   asp-controller="AutoTestAssignmentLogs"
                                   asp-action="Details"
                                   asp-route-id="@item.ID"
                                   class="btn-sapio btn-sapio-primary btn-sapio-sm">
                                    Detalji
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        $(document).ready(function () {

            $('#runsTable').DataTable({
                pageLength: 25,
                order: [[0, 'desc']],
                responsive: true,
                language: {
                    search: "Pretraga:",
                    lengthMenu: "Prikaži _MENU_ zapisa",
                    info: "Prikaz _START_ do _END_ od _TOTAL_ zapisa",
                    infoEmpty: "Nema zapisa",
                    zeroRecords: "Nema pronađenih logova",
                    paginate: {
                        first: "Prva",
                        last: "Zadnja",
                        next: "Sljedeća",
                        previous: "Prethodna"
                    }
                }
            });

        });

    </script>

}