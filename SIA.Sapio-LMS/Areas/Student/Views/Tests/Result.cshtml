@model SIA.Sapio.LMS.Data.Entities.PolaganjeTesta

@{
    ViewData["Title"] = "Rezultat testa";

    var procenat = Model.PROCENAT ?? 0;
    var passed = (Model.IS_PASSED ?? "N") == "Y";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-5 text-center">

                    <div class="mb-4">

                        @if (passed)
                        {
                            <div style="font-size:72px;">✅</div>
                        }
                        else
                        {
                            <div style="font-size:72px;">📄</div>
                        }

                    </div>

                    <h2 class="fw-bold mb-3">
                        Test je uspješno završen
                    </h2>

                    <p class="text-muted mb-4">
                        @Model.Test?.NAZIV
                    </p>

                    <div class="mb-4">

                        <div class="text-muted mb-2">
                            Ostvareni rezultat
                        </div>

                        <div class="display-4 fw-bold @(passed ? "text-success" : "text-warning")">
                            @procenat.ToString("0.##")%
                        </div>

                    </div>

                    <div class="alert alert-light border rounded-4 text-start">

                        Ukoliko je test sadržavao esejska pitanja,
                        instruktor će evaluirati Vaše odgovore naknadno.

                    </div>
                    <div class="alert alert-info border-0 rounded-4 mt-4 text-start">

                        <div class="fw-bold mb-2">
                            DEBUG / TEST INFO
                        </div>

                        <div>
                            <strong>Osvojeni bodovi:</strong>
                            @Model.OSTVARENI_BODOVI
                        </div>

                        <div>
                            <strong>Maksimalni bodovi:</strong>
                            @Model.MAX_BODOVI
                        </div>

                        <div>
                            <strong>Procenat:</strong>
                            @Model.PROCENAT%
                        </div>

                        <div>
                            <strong>Prolaz:</strong>
                            @Model.IS_PASSED
                        </div>

                        <div>
                            <strong>Status:</strong>
                            @Model.STATUS
                        </div>

                    </div>

                    <div class="mt-4">

                        <a href="/Student/Tests"
                           class="btn btn-primary px-4 py-2 rounded-pill">
                            Povratak na moje testove
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>