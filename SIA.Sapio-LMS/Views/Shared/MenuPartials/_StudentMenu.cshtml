@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
}

<li class="nav-item">
    <a class="nav-link @(currentArea == "Student" && currentController == "Dashboard" ? "active" : "")"
       href="/Student/Dashboard">
        <div class="icon icon-shape icon-sm text-center d-flex align-items-center justify-content-center">
            <i class="ni ni-book-bookmark text-success text-sm opacity-10"></i>
        </div>
        <span class="nav-link-text ms-1">Student Dashboard</span>
    </a>
</li>

<li class="nav-item">
    <a class="nav-link @(currentArea == "Student" && currentController == "Tests" ? "active" : "")"
       href="/Student/Tests">
        <div class="icon icon-shape icon-sm text-center d-flex align-items-center justify-content-center">
            <i class="ni ni-collection text-primary text-sm opacity-10"></i>
        </div>
        <span class="nav-link-text ms-1">Moji testovi</span>
    </a>
</li>