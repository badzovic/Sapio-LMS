@model List<SIA.Sapio_LMS.Areas.Models.TestAssignmentListItemVM>

@{
    ViewData["Title"] = "Testiranja";
}

<div class="page-toolbar d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Testiranja</h2>
        <p class="text-muted mb-0">
            Dodjela aktivnih testova studentima
        </p>
    </div>
</div>

<div class="card-custom">
    <div class="table-responsive">
        <table id="testAssignmentsTable" class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>Predmet</th>
                    <th>Test</th>
                    <th>Period</th>
                    <th>Broj pitanja</th>
                    <th>Dodijeljeno studenata</th>
                    <th style="width:180px;">Akcije</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.PredmetNaziv
                        </td>

                        <td>
                            <strong>@item.TestNaziv</strong>
                        </td>

                        <td>
                            <div>
                                <strong>Od:</strong>
                                @(item.DatumOd?.ToString("dd.MM.yyyy"))
                            </div>

                            <div>
                                <strong>Do:</strong>
                                @(item.DatumDo?.ToString("dd.MM.yyyy"))
                            </div>
                        </td>

                        <td>
                            @item.BrojPitanja
                        </td>

                        <td>
                            <span class="badge bg-info">
                                @item.BrojDodijeljenihStudenata
                            </span>
                        </td>

                        <td>
                            <a href="/TestAssignments/Assign/@item.TestId?mode=@ViewBag.Mode"
                               class="btn-sapio btn-sapio-primary btn-sm">
                                Dodijeli studentima
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {

    <script>
        $(document).ready(function () {

            $('#testAssignmentsTable').DataTable({
                pageLength: 25,
                order: [[0, 'asc']],
                responsive: true,
                language: {
                    search: "Pretraga:",
                    lengthMenu: "Prikaži _MENU_ zapisa",
                    info: "Prikazano _START_ do _END_ od ukupno _TOTAL_ zapisa",
                    infoEmpty: "Nema zapisa",
                    zeroRecords: "Nema pronađenih testova",
                    paginate: {
                        previous: "Prethodna",
                        next: "Sljedeća"
                    }
                }
            });

        });
    </script>
}